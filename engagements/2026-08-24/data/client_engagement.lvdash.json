        {
          "widget": {
            "name": "t_cost",
            "multilineTextboxSpec": {
              "lines": [
                "# Cost Visibility\n",
                "Built from `system.billing.usage`, which Unity Catalog exposes as an ordinary table. **Check the `untagged` row first:** cost can only be split by client if every job run carries a `client` tag, and tags cannot be applied retrospectively. Populated by notebook 06."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
