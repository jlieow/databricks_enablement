{
  "datasets": [
    {
      "name": "perf",
      "displayName": "Campaign engagement (master)",
      "queryLines": [
        "SELECT * FROM enablement.04_gold.gold_all_clients_master"
      ]
    },
    {
      "name": "perf_daily",
      "displayName": "Daily totals",
      "queryLines": [
        "SELECT report_date, client_id, tactic, SUM(impressions) AS impressions, SUM(engagements) AS engagements, SUM(leads) AS leads FROM enablement.04_gold.gold_all_clients_master GROUP BY report_date, client_id, tactic"
      ]
    },
    {
      "name": "perf_campaign",
      "displayName": "Campaign efficiency",
      "queryLines": [
        "SELECT client_id, tactic, campaign_name, SUM(impressions) AS impressions, SUM(engagements) AS engagements, SUM(leads) AS leads,       ROUND(SUM(engagements) * 100.0 / NULLIF(SUM(impressions), 0), 3) AS engagement_rate_pct,       ROUND(SUM(leads) * 100.0 / NULLIF(SUM(engagements), 0), 3) AS lead_rate_pct FROM enablement.04_gold.gold_all_clients_master GROUP BY client_id, tactic, campaign_name"
      ]
    },
    {
      "name": "dq",
      "displayName": "Data quality status",
      "queryLines": [
        "SELECT dq_status, dq_flags, COUNT(*) AS rows FROM enablement.03_silver.silver_helix_biosciences_engagement GROUP BY dq_status, dq_flags"
      ]
    },
    {
      "name": "dq_flagged",
      "displayName": "Flagged rows for review",
      "queryLines": [
        "SELECT report_date, tactic, campaign_id, campaign_name, impressions, engagements, leads, dq_flags FROM enablement.03_silver.silver_helix_biosciences_engagement WHERE dq_status = 'flagged'"
      ]
    },
    {
      "name": "cost",
      "displayName": "Cost per client",
      "queryLines": [
        "SELECT client, category, dbus, estimated_usd, projected_monthly_usd FROM enablement.05_ops.cost_per_client"
      ]
    }
  ],
  "pages": [
    {
      "name": "performance",
      "displayName": "Performance",
      "layout": [
        {
          "widget": {
            "name": "t_hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# Campaign Engagement\n",
                "Consolidated daily campaign engagement across tactics. Only rows that passed data quality validation are included. This is the internal report delivered about a client campaign."
              ]
