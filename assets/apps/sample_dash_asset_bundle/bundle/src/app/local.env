# src/app/local.env
#
# The LOCAL values, for running the app on your laptop (./run_local.sh, the
# sibling script here in src/app). Same variables the dev/prod bundle targets
# set - just the "local" flavour - kept right next to app.py and run_local.sh.
#
# This file lives UNDER source_code_path (../src/app is the app root), so it
# would normally be uploaded as app code. A `sync.exclude` rule in
# config/sync.yml keeps it (and run_local.sh) OUT of every deploy, so it only
# ever affects a LOCAL run. The bundle does not read it; on `databricks bundle
# deploy -t dev|prod` the app gets the target's values via resources/app.yml ->
# config.env, which OVERRIDE these.
#
# Values are quoted because APP_TITLE contains spaces; uv's --env-file parser
# strips the surrounding quotes when run_local.sh loads them.
APP_ENV="local"
APP_NAME="sample-dash-bundle-local"
APP_TITLE="Dash Asset Bundle (local)"
# JOB_ID and WAREHOUSE_ID are intentionally unset locally - there is no deployed
# job to trigger (the button reports "JOB_ID is not set") and no warehouse to
# query (the chart falls back to computing in pandas). On a deployed target both
# are injected from the app's resource bindings (resources/app.yml).
