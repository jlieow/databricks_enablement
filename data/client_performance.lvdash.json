{
  "datasets": [
    {
      "name": "perf",
      "displayName": "Client performance (master)",
      "queryLines": [
        "SELECT * FROM enablement.04_gold.gold_all_clients_master_filtered"
      ]
    },
    {
      "name": "perf_daily",
      "displayName": "Daily totals",
      "queryLines": [
        "SELECT report_date, client_id, platform, SUM(impressions) AS impressions, SUM(clicks) AS clicks, SUM(conversions) AS conversions, SUM(spend_usd) AS spend_usd FROM enablement.04_gold.gold_all_clients_master_filtered GROUP BY report_date, client_id, platform"
      ]
    },
    {
      "name": "perf_campaign",
      "displayName": "Campaign efficiency",
      "queryLines": [
        "SELECT client_id, platform, campaign_name, SUM(impressions) AS impressions, SUM(clicks) AS clicks, SUM(conversions) AS conversions, ROUND(SUM(spend_usd), 2) AS spend_usd,       ROUND(SUM(clicks) * 100.0 / NULLIF(SUM(impressions), 0), 3) AS ctr_pct,       ROUND(SUM(spend_usd) / NULLIF(SUM(conversions), 0), 2) AS cpa_usd FROM enablement.04_gold.gold_all_clients_master_filtered GROUP BY client_id, platform, campaign_name"
      ]
    },
    {
      "name": "dq",
      "displayName": "Data quality status",
      "queryLines": [
        "SELECT dq_status, dq_flags, COUNT(*) AS rows FROM enablement.03_silver.silver_northwind_retail_performance GROUP BY dq_status, dq_flags"
      ]
    },
    {
      "name": "dq_flagged",
      "displayName": "Flagged rows for review",
      "queryLines": [
        "SELECT report_date, platform, campaign_id, campaign_name, impressions, clicks, spend, conversions, dq_flags FROM enablement.03_silver.silver_northwind_retail_performance WHERE dq_status = 'flagged'"
      ]
    },
    {
      "name": "cost",
      "displayName": "Cost per client",
      "queryLines": [
        "SELECT client, category, dbus, estimated_usd, projected_monthly_usd FROM enablement.05_ops.cost_per_client"
      ]
    }
  ],
  "pages": [
    {
      "name": "performance",
      "displayName": "Performance",
      "layout": [
        {
          "widget": {
            "name": "t_hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# Client Performance\n",
                "Consolidated daily advertising performance. Spend shown in USD for cross-client comparison. Only rows that passed data quality validation are included."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "c_spend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "perf",
                  "fields": [
                    {
                      "name": "spend_usd",
                      "expression": "SUM(`spend_usd`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "spend_usd",
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Total Spend (USD)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
